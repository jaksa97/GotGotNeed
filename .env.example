# Copy this file to .env and adjust values if needed.
# .env is git-ignored so real/local credentials never get committed.
#
# These defaults match the values baked into backend/src/main/resources/application.yaml,
# so the backend works out of the box against the Dockerized MySQL without exporting anything.

# --- MySQL container (docker-compose.yml) ---
MYSQL_DATABASE=gotgotneed
MYSQL_USER=gotgotneed
MYSQL_PASSWORD=gotgotneed
# Root password is only needed for administrative access to the container.
MYSQL_ROOT_PASSWORD=gotgotneed
# Host port that maps to the container's 3306.
MYSQL_PORT=3306

# --- Backend container (docker-compose.yml) ---
# Host port that maps to the backend container's 8080.
BACKEND_PORT=8080

# --- Spring Boot datasource (backend/src/main/resources/application.yaml) ---
# Used when running the backend directly on the host, e.g. `./gradlew :backend:bootRun`.
# DB_NAME/DB_USERNAME/DB_PASSWORD must match MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD
# above, since that's what actually creates the database/user in the MySQL container.
#
# NOTE: when the backend runs *inside* docker-compose instead (`docker compose up backend`),
# DB_HOST/DB_PORT are overridden to `mysql`/`3306` directly in docker-compose.yml, since
# "localhost" would (incorrectly) mean the backend container itself, not the mysql container.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gotgotneed
DB_USERNAME=gotgotneed
DB_PASSWORD=gotgotneed
