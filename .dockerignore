# This file scopes the Docker build context (used by backend/Dockerfile,
# whose build context is the repo root since the Gradle build needs the
# whole monorepo — see backend/Dockerfile for why).

# Version control
.git
.gitignore

# Gradle / Kotlin build outputs and caches (regenerated by the build stage)
**/build/
.gradle
.kotlin
kotlin-js-store/.yarn

# IDE / editor
.idea
*.iml
.vscode

# OS cruft
.DS_Store

# Node (webApp)
node_modules

# iOS / Xcode (irrelevant to the backend build, and often huge/user-specific)
iosApp/**/xcuserdata
**/*.xcodeproj/xcuserdata
**/DerivedData

# Local machine-specific files (Android SDK path, not needed to build :backend)
local.properties

# Secrets / local env overrides — never send these into a build context
.env
!.env.example

# Docker-related files themselves don't need to be in the image
Dockerfile
docker-compose.yml
